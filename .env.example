# CRIP environment configuration — EXAMPLE ONLY
#
# Copy to `.env` and fill in as needed. NEVER commit a real `.env` with keys.
# Every setting below is OPTIONAL: with none of them set, CRIP runs fully
# offline using mock/fallback backends (no API keys, no GPU, no internet).

# ---------------------------------------------------------------------------
# LLM brain — turns natural-language missions into task plans
#   mock      (default) offline rule-based planner. NOT a real language model.
#   ollama    local open-weight model (Llama / Qwen / Mistral). Fully offline
#             once the model is pulled: `ollama pull llama3`
#   anthropic Claude via the Anthropic API. PAID; requires internet + a key.
# ---------------------------------------------------------------------------
CRIP_LLM_BACKEND=mock
# CRIP_LLM_MODEL=llama3
# ANTHROPIC_API_KEY=            # only if CRIP_LLM_BACKEND=anthropic

# ---------------------------------------------------------------------------
# VLM — vision-language scene assessment (same backend options)
# ---------------------------------------------------------------------------
CRIP_VLM_BACKEND=mock
# CRIP_VLM_MODEL=llava

# ---------------------------------------------------------------------------
# Embeddings — semantic memory recall
#   hashing (default) offline lexical similarity, no model needed
#   local             a local embedding model
#   api               a hosted embedding API (requires CRIP_EMBED_KEY)
# ---------------------------------------------------------------------------
CRIP_EMBED_BACKEND=hashing
# CRIP_EMBED_KEY=

# ---------------------------------------------------------------------------
# Fleet transport — multi-robot sharing
#   unset (default) in-process broker (single robot / tests)
#   host:port       real MQTT broker, e.g. localhost:1883 (run mosquitto)
# ---------------------------------------------------------------------------
# CRIP_FLEET_MQTT=localhost:1883

# ---------------------------------------------------------------------------
# World model storage — unset uses the SQLite/NumPy fallback automatically
# ---------------------------------------------------------------------------
# CRIP_DB_HOST=localhost
# CRIP_DB_NAME=crip
# CRIP_DB_USER=crip
# CRIP_DB_PASSWORD=
